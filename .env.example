# Postgres. docker compose sets this for you; set it yourself when running npm run dev.
DATABASE_URL=postgres://reddit_leads:reddit_leads@localhost:5433/reddit_leads

# The public origin of this instance. Must match the OAuth redirect you registered.
APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts stored AnyAPI refresh tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# true on a self-hosted instance: removes every tier limit.
SELF_HOSTED=true

# true on exactly one process: runs the every-minute job tick. Leave it off
# locally unless you are working on the jobs: on, it scans every project in
# the database at your model keys' expense.
RUN_SCHEDULER=false

# Clerk (https://clerk.com). Create an application and paste its two keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AnyAPI (https://getanyapi.com).
ANYAPI_BASE_URL=https://api.getanyapi.com
# Printed by: npm run anyapi:register
ANYAPI_OAUTH_CLIENT_ID=
# The key this instance falls back to when a user has not connected a wallet.
ANYAPI_HOUSE_API_KEY=

# OpenRouter pays for judging every title, post and comment the scan reads
# (TypeSafe's Jev), and for the product profile, drafting and clustering.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
JEV_MODEL=~typesafe/jev-latest
# Vercel's AI Gateway asks Jev first when this is set; OpenRouter answers when
# it is unset or fails.
AI_GATEWAY_API_KEY=
JEV_GATEWAY_MODEL=typesafe-ai/jev

# Email digests. The From address, plus one carrier. When both are set Azure wins.
# Must be an address on a domain the carrier has verified.
ALERTS_FROM_EMAIL=
# Azure Communication Services: the Communication resource's connection string.
AZURE_EMAIL_CONNECTION_STRING=
# Any SMTP server, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
# Once true, people with leads and no alert channel are asked once each, by
# email, whether they want new leads sent to them. Needs email set up above.
ALERT_INVITES=false

# Add to Slack. Optional: without these, Slack takes a pasted webhook URL.
# A Slack app with Incoming Webhooks on and <APP_URL>/connect/slack/callback as a redirect URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Add to Discord. Optional: without these, Discord takes a pasted webhook URL.
# A Discord app with <APP_URL>/connect/discord/callback as an OAuth2 redirect. Its name
# and icon are what the channel's webhook starts with.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Daily ceilings on what the house key spends, in USD. Ignored per wallet-funded user.
HOUSE_DATA_CAP_USD_PER_DAY=50
HOUSE_LLM_CAP_USD_PER_DAY=10

# X leads (beta). Off by default: the X tab is a 404 and no X job runs until X_LEADS=true.
X_LEADS=false
# The "Worth a reply" kind in the X tab. On with X; false turns only replies off.
X_REPLIES=true
# X's own share of the house ceilings above, in USD a day.
HOUSE_X_DATA_CAP_USD_PER_DAY=5
HOUSE_X_LLM_CAP_USD_PER_DAY=5
# Paid twitter.* calls in flight at once.
X_CALLS_IN_FLIGHT=8

# Webhooks may only reach public addresses. A self-hosted instance that delivers
# to its own network sets this to true.
ALERTS_ALLOW_PRIVATE_WEBHOOKS=false

# Internal agency deployment (see AGENCY_SETUP.md).
# Enable explicitly; an empty allowlist denies all agency sign-ins.
AGENCY_MODE=false
AGENCY_ALLOWED_EMAILS=
AGENCY_WORKSPACE_ID=internal-agency
DATA_PROVIDER=anyapi
APIFY_TOKEN=
# This adapter uses trudax/reddit-scraper-lite's documented schema.
APIFY_MAX_ITEMS=20
APIFY_MAX_RUN_USD=0.10
# Separate from the existing daily limit. Applies to Apify and DataForSEO.
DATA_MONTHLY_CAP_USD=5
PROJECT_DATA_MONTHLY_CAP_USD=2
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
AI_PROVIDER=openrouter
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Estimates for usage reporting; update when changing models.
CLOUDFLARE_INPUT_USD_PER_MILLION=0.293
CLOUDFLARE_OUTPUT_USD_PER_MILLION=2.253
