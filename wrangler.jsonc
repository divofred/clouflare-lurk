{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lurk-agency",
  "workers_dev": true,
  "preview_urls": true,
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "ai": { "binding": "AI", "remote": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "APP_URL": "https://lurk-agency.bolts.workers.dev",
    "SELF_HOSTED": "true",
    "AGENCY_MODE": "false",
    "AGENCY_WORKSPACE_ID": "internal-agency",
    "AGENCY_ALLOWED_EMAILS": "fredrickemmanuelc@gmail.com,gilbert.galindo@gmail.com",
    "DATA_PROVIDER": "apify",
    "AI_PROVIDER": "cloudflare",
    "RUN_SCHEDULER": "false",
    "SCHEDULER_SEED": "false",
    "SCANS_ENABLED": "true",
    "X_LEADS": "false",
    "APIFY_MAX_ITEMS": "20",
    "APIFY_MAX_RUN_USD": "0.10",
    "DATA_MONTHLY_CAP_USD": "5",
    "PROJECT_DATA_MONTHLY_CAP_USD": "2",
    "HOUSE_DATA_CAP_USD_PER_DAY": "0.50",
    "HOUSE_LLM_CAP_USD_PER_DAY": "1",
    "REDDIT_CALLS_IN_FLIGHT": "1",
    "REDDIT_CALLS_PER_SECOND": "1"
  }
}
